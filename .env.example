# Server-only Places API (New) key. Never prefix with NEXT_PUBLIC_.
GOOGLE_PLACES_API_KEY=

# Rutherford Spine & Wellness Center listing only.
GOOGLE_PLACE_ID=ChIJp1t3Lnb4Y4gRIkxhiYl6rTY

# Payload CMS
PAYLOAD_SECRET=
PREVIEW_SECRET=
DATABASE_URL=
# Optional direct (unpooled) Neon URL. Prefer the pooled DATABASE_URL above.
DATABASE_URL_UNPOOLED=

# Public origin of the live site. On Vercel this must be https, never localhost.
NEXT_PUBLIC_SITE_URL=https://rutherfordchiropractic.com

# Local: http://localhost:3000
# Vercel Production / Preview: the public https origin (never localhost).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload admin origin. Leave unset to use http://localhost:3000 locally
# and https://admin.{NEXT_PUBLIC_SITE_URL host} in production.
# Point DNS for admin.rutherfordchiropractic.com at the same Vercel project.
# NEXT_PUBLIC_ADMIN_URL=https://admin.rutherfordchiropractic.com

# Optional. Without this, Payload stores media locally at /media (404s on Vercel).
BLOB_READ_WRITE_TOKEN=
